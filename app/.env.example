# Frontend Environment Configuration (Vite)
#
# IMPORTANT SECURITY RULES:
# - All VITE_* variables are bundled into public client JavaScript.
# - DO NOT place secrets, private keys, database passwords, or auth tokens here.
# - The value must be an HTTPS origin: https://<hostname>[:<port>] (no paths or queries).

# Production backend API origin.
# Local development: leave unset or blank to use Vite's proxy (http://127.0.0.1:8000).
# Cloudflare Pages production: set to your deployed backend HTTPS origin.
VITE_API_BASE_URL=https://api.example.com

