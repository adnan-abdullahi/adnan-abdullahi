# Django Backend Environment Configuration Template
# Copy this file to backend/.env and populate with deployment-specific values.
# NEVER commit backend/.env or real secrets to version control.

# Core Django Configuration
DJANGO_SECRET_KEY=change-this-to-a-secure-random-secret-key-at-least-50-characters
DJANGO_DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,api.example.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://portfolio.example.com

# Database Runtime Account (Least-privilege: SELECT, INSERT, UPDATE only)
# Used by WSGI/ASGI web service, runserver, showmigrations, makemigrations
DB_NAME=portfolio_db
DB_USER=portfolio_user
DB_PASSWORD=your_runtime_password_here
DB_HOST=127.0.0.1
DB_PORT=3306

# Optional TLS / SSL Configuration (Required for remote hosts such as TiDB Cloud Serverless)
# DB_SSL_MODE=VERIFY_IDENTITY
# DB_SSL_CA=/etc/ssl/certs/ca-certificates.crt

# Database Migration Account (DDL + DML: CREATE, ALTER, DROP, INDEX, REFERENCES, SELECT, INSERT, UPDATE, DELETE)
# OPTIONAL: Only required when executing 'python manage.py migrate' out-of-band on Linux or CI.
# On Windows, local development uses Windows Credential Manager ('portfolio_db_migrator') by default.
# CRITICAL SECURITY RULE: The Render web service environment must NOT contain
# DB_MIGRATE_USER or DB_MIGRATE_PASSWORD. Migrations are executed out-of-band.
# DB_MIGRATE_USER=portfolio_migrator
# DB_MIGRATE_PASSWORD=your_elevated_migration_password_here

# Contact Notification Service (Resend HTTPS API)
# RESEND_API_KEY: Resend API key (e.g. re_123456789).
# In local development (DJANGO_DEBUG=True), set to 'simulate' to log without outbound dispatch.
# In production (DJANGO_DEBUG=False), 'simulate' is prohibited and fails closed.
RESEND_API_KEY=
# EMAIL_SIMULATION_ALLOWED: Defaults to False. Set to True only for test environments.
# EMAIL_SIMULATION_ALLOWED=False
# CONTACT_NOTIFICATION_TO: Portfolio owner email to receive visitor messages.
CONTACT_NOTIFICATION_TO=
# CONTACT_NOTIFICATION_FROM: Verified sender email (e.g. Portfolio Contact <contact@yourdomain.com> or onboarding@resend.dev)
CONTACT_NOTIFICATION_FROM=
